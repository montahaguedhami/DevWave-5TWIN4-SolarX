        </owl:members>
    </owl:AllDisjointClasses>

    <!-- Propriétés de données ajoutées (valeur, unite, dateMesure, nom et situeDans existants sont réutilisés) -->
    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/monta/ontologies/2026/10/SolarX#latitude">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/monta/ontologies/2026/10/SolarX#Localisation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="fr">Latitude WGS84 en degrés décimaux (-90 à 90).</rdfs:comment>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/monta/ontologies/2026/10/SolarX#longitude">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/monta/ontologies/2026/10/SolarX#Localisation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="fr">Longitude WGS84 en degrés décimaux (-180 à 180).</rdfs:comment>
