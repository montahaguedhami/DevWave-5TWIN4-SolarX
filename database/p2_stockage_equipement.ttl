#################################################################

:Capteur_01  :nom "Capteur Hôpital Tunis" ; :marque "Schneider Electric" .
:Compteur_01 :nom "Compteur intelligent Maison Djerba" ; :marque "Sagemcom" .
:Onduleur_01 :nom "Onduleur parc solaire Djerba" ; :marque "SMA" ; :puissanceMaxKW "100"^^xsd:decimal .

