    :dateInstallation "2024-03-12T00:00:00"^^xsd:dateTime .

# Qui possède quoi (la localisation d'un équipement = celle de son propriétaire)
:Maison_01          :possede :Compteur_02, :Onduleur_02 .
:Hopital_Tunis      :possede :Compteur_03, :Onduleur_04 .
:Ecole_Tunis        :possede :Compteur_04 .
:Usine_Tunis        :possede :Compteur_05, :Capteur_05 .
:Maison_Djerba      :possede :Onduleur_05 .
:ParcSolaire_Djerba :possede :Capteur_03 .
:CentraleSolaire_01 :possede :Capteur_02, :Onduleur_03 .
:ParcEolien_Tunis   :possede :Capteur_04 .
