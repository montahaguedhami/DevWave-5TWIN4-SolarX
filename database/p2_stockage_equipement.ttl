    :nom "Compteur École Tunis" ; :marque "Itron" ;
    :dateInstallation "2018-04-30T00:00:00"^^xsd:dateTime ; :etat "En panne" .
:Compteur_05 a owl:NamedIndividual, :CompteurIntelligent ;
