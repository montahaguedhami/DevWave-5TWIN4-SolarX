# Application
APP_NAME=SolarX Backend
APP_VERSION=0.1.0
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000

# CORS (comma-separated list is not supported; edit config.py or use JSON)
CORS_ORIGINS=["http://localhost:3000"]

# Database
DATABASE_URL=sqlite:///./solarx.db

# Security
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Apache Jena Fuseki
FUSEKI_URL=http://localhost:3030
FUSEKI_DATASET=solarx
# FUSEKI_USER=admin
# FUSEKI_PASSWORD=

# Open-Meteo
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast

# Google Gemini (clé : https://aistudio.google.com/apikey) - ne jamais committer la vraie clé
GEMINI_API_KEY=
GEMINI_MODELS=["gemini-3.5-flash","gemini-3.5-flash-lite","gemini-flash-lite-latest"]