# URL SPARQL du dataset Fuseki (le nom "solarx" = nom du dataset créé dans Fuseki)
FUSEKI_URL=http://localhost:3030/solarx/sparql
# IRI de l'ontologie + "#" (Protégé → Active ontology → Ontology IRI)
SOLARX_NS=http://www.semanticweb.org/monta/ontologies/2026/10/SolarX#
# Origines autorisées pour le frontend (séparées par des virgules)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
