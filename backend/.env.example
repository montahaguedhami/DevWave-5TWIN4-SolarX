# Application
APP_NAME=SolarX Backend
APP_VERSION=0.1.0
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000

# CORS (comma-separated list is not supported; edit config.py or use JSON)
CORS_ORIGINS=["http://localhost:3000"]

# Database
DATABASE_URL=sqlite:///./solarx.db

# Security
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440